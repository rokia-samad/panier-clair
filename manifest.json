{
  "manifest_version": 3,
  "name": "Panier Etiq — Qualité produits",
  "version": "0.3.0",
  "description": "Les repères Open Food Facts pendant vos courses E.Leclerc Drive.",
  "browser_specific_settings": {
    "gecko": {
      "id": "qualite-drive-off-prototype@local",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": ["storage"],
  "icons": {
    "48": "icons/product-guide.svg",
    "96": "icons/product-guide.svg"
  },
  "action": {
    "default_title": "Panier Etiq",
    "default_icon": "icons/product-guide.svg",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://*.leclercdrive.fr/*",
    "https://world.openfoodfacts.org/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.leclercdrive.fr/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
